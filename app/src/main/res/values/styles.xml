<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/syn_bg</item>
        <item name="android:navigationBarColor">@color/syn_bg</item>
        <item name="android:windowBackground">@color/syn_bg</item>
        <item name="android:textColor">@color/syn_text</item>
    </style>

    <!-- UI helpers -->
    <style name="Card">
        <item name="android:background">@color/syn_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="H1">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/syn_text</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/syn_muted</item>
    </style>

    <!-- Keyboard key styles -->
    <style name="Key" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/syn_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
    </style>

    <style name="KeyWide" parent="Key">
        <item name="android:layout_weight">1.2</item>
    </style>

    <style name="KeyExtraWide" parent="Key">
        <item name="android:layout_weight">3</item>
    </style>
</resources>
